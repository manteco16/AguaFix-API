# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.

# API
PORT=3000
CORS_ORIGINS=

# Base de datos
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=aguafix
DB_PASSWORD=cambia_esta_password
DB_NAME=aguafix

# Correo (Gmail con contraseña de aplicación)
MAILER_SERVICE=gmail
MAILER_USER=tu_correo@gmail.com
MAILER_PASSWORD=tu_password_de_aplicacion
MAILER_TO=destino@ejemplo.com

# Mapbox (opcional)
MAPBOX_TOKEN=

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=nombre-del-bucket

# Solo para desarrollo local. En EC2 se usa el IAM instance profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
